{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MEDORA",
  "version": "0.0.0",
  "identifier": "do.medora.app",
  "build": {
    "beforeBuildCommand": "npm --prefix ../app ci && npm --prefix ../app run build",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MEDORA",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Medical",
    "shortDescription": "Sistema de gestión hospitalaria",
    "longDescription": "MEDORA — sistema de gestión hospitalaria multi-sistema (pacientes, turnos, caja, inventario, nómina y contabilidad)."
  }
}
